# Base de datos
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/financiera

# CORS (frontend local en dev, Railway URL en prod)
CORS_ORIGINS=["http://localhost:5173"]

# IA
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Motor de IA del bot (ver app/services/ia/motor.py) ──────────────────
# Qué proveedor interpreta cada camino: anthropic | openai. Se eligen por
# SEPARADO porque son dos trabajos con riesgos distintos: un error leyendo una
# foto de cheque no da ninguna señal (plata mal cargada con un JSON impecable),
# mientras que uno interpretando texto se ve en el acto y además tiene escalada.
# Cambiar solo el de texto es la prueba de bajo riesgo.
IA_PROVIDER_TEXTO=anthropic
IA_PROVIDER_OCR=anthropic

# Modelos de OpenAI (los de Claude van hardcodeados en services/ia/claude.py).
OPENAI_MODEL_TEXTO=gpt-5
OPENAI_MODEL_OCR=gpt-5
OPENAI_MODEL_CONFIRMACION=gpt-5-mini
# Esfuerzo de razonamiento: minimal | low | medium | high.
# Vacío = no se manda el parámetro (para un modelo que no lo soporte).
OPENAI_EFFORT_TEXTO=low
OPENAI_EFFORT_OCR=medium
# El clasificador de "dale"/"no". Su tope cubre razonamiento + respuesta, así
# que un modelo que razona de más se queda sin lugar para el veredicto y el bot
# le cancela la operación al operador: por eso "minimal".
OPENAI_EFFORT_CONFIRMACION=minimal

# WAHA (WhatsApp HTTP API — gateway no oficial, engine NOWEB)
WAHA_API_URL=https://tu-waha.railway.app
WAHA_API_KEY=tu-api-key-de-waha
WAHA_SESSION=default

# Número del operador autorizado (solo dígitos, con código de país)
# Ejemplo Argentina: 5491123456789
WHATSAPP_OPERATOR_PHONE=5491123456789

# Autenticación del panel (login)
# Clave para firmar los tokens de sesión (JWT HS256). OBLIGATORIA en producción:
# generá una aleatoria larga (p. ej. `openssl rand -hex 32`).
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Admin raíz: se crea al arrancar si no existe ningún admin. Si olvidás la clave,
# cambiá ADMIN_PASSWORD acá/en Railway y reiniciá para recuperar el acceso.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave-de-admin
# URL pública del sistema para armar los enlaces de invitación (sin barra final).
# Opcional: si queda vacía, el front usa su propio origen.
# También la usa el chequeo de salud para verificar que WAHA siga apuntando su
# webhook a este backend — conviene definirla en producción.
PUBLIC_BASE_URL=https://tu-dominio.app

# ── Monitoreo de salud y alertas ─────────────────────────────────────
# Telegram es el canal de alerta porque NO depende de WhatsApp: cuando se cae la
# sesión del bot, avisar por WhatsApp es imposible.
# 1. Crear el bot con @BotFather (/newbot) → devuelve el token.
# 2. Escribirle al bot (o agregarlo al grupo) y abrir
#    https://api.telegram.org/bot<TOKEN>/getUpdates para ver el chat id.
TELEGRAM_BOT_TOKEN=123456789:AA...
# Uno o varios chat ids separados por coma (los grupos empiezan con -100).
TELEGRAM_CHAT_IDS=123456789

# Protege GET /health/deep (query ?token= o header X-Health-Token). El watchdog
# externo (.github/workflows/healthcheck.yml) usa el mismo valor.
HEALTH_TOKEN=cambia-esto-por-un-token-largo

# Monitor interno (valores por defecto; se pueden omitir)
# Por decisión del dueño solo se avisa la CAÍDA y la RECUPERACIÓN del bot: las
# dos últimas encienden mensajes que nadie pidió y por eso vienen apagadas.
MONITOR_ACTIVO=true
MONITOR_INTERVALO_SEGUNDOS=120
MONITOR_UMBRAL_FALLOS=2
MONITOR_REPETIR_MINUTOS=30
MONITOR_DEMORA_INICIAL_SEGUNDOS=45
MONITOR_AVISAR_ARRANQUE=false
MONITOR_ALERTAR_DEGRADADO=false
